---
import { getCollection } from 'astro:content';
import { site } from '../site';
import Base from '../components/parts/base.astro';
import Footer from '../components/parts/footer.astro';

const allBlogPosts = await getCollection('blog');
if (allBlogPosts.length === 0) {
  allBlogPosts.push({
        id: 'no-posts',
        data: {
            title: 'No posts yet',
            description: 'Hopefully coming soon!',
            date: new Date(),
            permalink: '',
        },
        collection: 'blog'
    }
  )
}
allBlogPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const postsByYear = Map.groupBy(allBlogPosts, post => post.data.date.getFullYear());
const dateFormat = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric' });
---
<style lang="scss">
@use '../styles/tokens.scss';
.blog-header {
  width: 100%;
  max-width: 700px;
  margin: 0 auto;
  position: relative;
  padding: 0;
  box-sizing: border-box;
  border-bottom: 1px solid black;
}

.blog-header .blog-title {
  margin-bottom: 8px;
  font-size: 50px;
  font-weight: 700;
  letter-spacing: -2px;
  outline: 0;
  line-height: 50px;
  word-break: break-word;
  color: tokens.$rajsite-30-font-color;
}

.blog-header .blog-description {
  font-size: 28px;
  margin: 0 0 20px;
  padding: 0;
  line-height: 1.2;
  color: tokens.$rajsite-60-font-color;
  font-weight: 300;
}

.year-marker {
  font-size: 28px;
  font-weight: 700;
  margin: 32px 0 16px;
  color: tokens.$rajsite-30-font-color;
}

.post {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  column-gap: 16px;
  padding: 8px 0;
}

.post .post-meta {
  white-space: nowrap;
  font-family: tokens.$rajsite-body-font-family;
  font-size: 14px;
  color: tokens.$rajsite-90-font-color;
  line-height: 30px;
}

.post .post-meta a {
  color: tokens.$rajsite-90-font-color;
  text-decoration: none;
}

.post .post-meta a:hover {
  text-decoration: underline;
}

.post .post-title {
  font-weight: 700;
  font-style: normal;
  letter-spacing: -0.02em;
  font-size: 24px;
  line-height: 1.15;
  color: tokens.$rajsite-30-font-color;
  margin: 0;
}

.post .post-title a {
  text-decoration: none;
  color: tokens.$rajsite-30-font-color;
}

.post .post-title a:hover {
  text-decoration: none;
}

.post .post-excerpt {
  letter-spacing: -0.02em;
  font-weight: 300;
  font-style: normal;
  font-size: 18px;
  line-height: 1.59;
  margin: 0;
  color:tokens.$rajsite-60-font-color;
}

.content {
  width: 100%;
  max-width: 700px;
  margin: 25px auto 0 auto;
  box-sizing: border-box;
}

@media only screen and (max-width: 800px) {
  .content {
    padding: 0 16px;
  }
}

</style>
<Base title="Home" description={site.description} id="/">

    <main class="content">

        <header class="blog-header">
            <h1 class="blog-title">{ site.name }</h1>
            <h2 class="blog-description">{ site.description }</h2>
        </header>

        {[...postsByYear].map(([year, posts]) => (
            <section class="year">
                <h2 class="year-marker">{year}</h2>
                {posts.map(post => (
                    <article class="post">
                        <header class="post-title"><a href={post.id}>{post.data.title}</a></header>
                        <section class="post-excerpt">{post.data.description} <time class="post-meta" datetime={post.data.date.toISOString()}>{dateFormat.format(post.data.date)}</time></section>
                    </article>
                ))}
            </section>
        ))}
    </main>

    <Footer />
</Base>
